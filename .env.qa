# Committed settings for ENV=qa - no secrets (those go in .env.qa.local, see .env.example).
# LOG_LEVEL here has no effect: the logger reads only the real environment (shell / CI), not .env files.
ENV=qa
LOG_LEVEL=info
HEADLESS=true
BASE_URL=https://qa.example.com
API_BASE_URL=https://api.qa.example.com
