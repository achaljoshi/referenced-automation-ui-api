{
  "name": "@automation/referenced-automation-ui-api",
  "version": "1.0.0",
  "description": "Composes referenced-automation-ui, referenced-automation-api, referenced-automation-sap, and referenced-automation-utils as plain npm dependencies - zero duplicated framework code. This repo is almost entirely glue: page objects, a tiny sample server, and specs proving these frameworks work together in one test, including sharing session state (a cookie/token) between an API-driven step and a UI step, plus demo coverage of every reusable method each dependency exports.",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "install:browsers": "playwright install --with-deps chromium firefox webkit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "dependencies": {
    "@automation/referenced-automation-api": "file:../shared-packages/automation-referenced-automation-api-1.0.0.tgz",
    "@automation/referenced-automation-sap": "file:../shared-packages/automation-referenced-automation-sap-1.0.0.tgz",
    "@automation/referenced-automation-ui": "file:../shared-packages/automation-referenced-automation-ui-1.0.0.tgz",
    "@automation/referenced-automation-utils": "file:../shared-packages/automation-referenced-automation-utils-1.0.0.tgz"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/smtp-server": "^3.5.13",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.9",
    "eslint": "^8.57.1",
    "smtp-server": "^3.19.3",
    "ssh2": "^1.17.0",
    "typescript": "^5.7.3"
  }
}
