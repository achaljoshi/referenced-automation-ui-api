<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.company.automation</groupId>
    <artifactId>referenced-automation-ui-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Referenced Automation UI+API Composition Framework</name>
    <description>
        Composes referenced-automation-ui, referenced-automation-api and
        referenced-automation-utils as plain Maven dependencies - zero
        duplicated framework code. Ships only glue (hooks reused as-is, plus
        this repo's own page objects/step definitions/sample features) that
        exercises both frameworks together in a single Cucumber scenario,
        including sharing Playwright browser session state between an
        API-driven step and a UI step. Cucumber + Java + Maven, published to
        Nexus and imported as a Maven dependency like any other library.
    </description>
    <url>https://github.com/achaljoshi/referenced-automation-ui-api</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- ===== Version properties (bump here, nowhere else) ===== -->
        <ui.version>1.0.0-SNAPSHOT</ui.version>
        <api.version>1.0.0-SNAPSHOT</api.version>
        <utils.version>1.0.0-SNAPSHOT</utils.version>

        <!-- Must match referenced-automation-ui's own aspectj.version - a dependency's
             <properties> are NOT inherited by consumers, so this is redeclared here
             purely to build the -javaagent path below (same reason
             referenced-automation-sap redeclares it). -->
        <aspectj.version>1.9.25.1</aspectj.version>

        <maven.surefire.version>3.5.6</maven.surefire.version>
        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.source.plugin.version>3.3.1</maven.source.plugin.version>
        <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
        <maven.resources.plugin.version>3.3.1</maven.resources.plugin.version>
        <maven.deploy.plugin.version>3.1.4</maven.deploy.plugin.version>
        <versions.plugin.version>2.18.0</versions.plugin.version>
        <exec.plugin.version>3.6.3</exec.plugin.version>

        <!-- Overridable at runtime: mvn test -Dbrowser=chromium -Denv=qa -Dheadless=true -->
        <browser>chromium</browser>
        <env>qa</env>
        <headless>true</headless>

        <argLine>
            -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
        </argLine>
    </properties>

    <!-- ===================================================================
         src/main is intentionally near-empty - see README "Why src/main is
         almost empty". This repo's value is entirely in src/test: sample
         scenarios that prove referenced-automation-ui + referenced-automation-api
         + referenced-automation-utils compose cleanly with zero duplicated
         framework code.
         =================================================================== -->
    <dependencies>

        <!-- Playwright browser automation for Fiori/SauceDemo-style UI steps: BasePage,
             PlaywrightFactory/PlaywrightManager, WaitUtils, ScreenshotUtils, ConfigReader,
             untagged Hooks (browser/context/page lifecycle for every scenario),
             StepLoggerPlugin, Extent+Allure reporting, Log4j2 config. -->
        <dependency>
            <groupId>com.company.automation</groupId>
            <artifactId>referenced-automation-ui</artifactId>
            <version>${ui.version}</version>
        </dependency>

        <!-- Playwright-based REST client for API steps: ApiClient/ApiRequestSpec/
             ApiResponseWrapper, ApiContextFactory/ApiContextManager, untagged ApiHooks
             (APIRequestContext lifecycle for every scenario). Its own ConfigReader/
             StepLoggerPlugin/Extent/Allure/Log4j2 copies exist only because
             referenced-automation-api is designed to also work completely standalone
             (see that repo's README) - this repo deliberately uses only ONE canonical
             copy of each (referenced-automation-ui's) in its own plugin chain and
             resource files; see README "Resolving the resource collisions". -->
        <dependency>
            <groupId>com.company.automation</groupId>
            <artifactId>referenced-automation-api</artifactId>
            <version>${api.version}</version>
        </dependency>

        <!-- Shared commons - test data, JSON/YAML, crypto, generic config loading.
             Already a transitive dependency via referenced-automation-api, redeclared
             directly here anyway (same convention as every other repo in this family)
             so this repo's own glue can use it without relying on transitive resolution. -->
        <dependency>
            <groupId>com.company.automation</groupId>
            <artifactId>referenced-automation-utils</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- cucumber-java/cucumber-junit-platform-engine/cucumber-picocontainer, junit-jupiter,
             junit-platform-suite/launcher, extentreports-cucumber7-adapter, allure-cucumber7-jvm,
             aspectjweaver, slf4j-api, log4j-core/log4j-slf4j2-impl, jackson-databind, commons-io
             all come transitively from referenced-automation-ui (and, redundantly, from
             referenced-automation-api too) - intentionally not redeclared. -->
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven.resources.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <argLine>${argLine}</argLine>
                    <includes>
                        <include>**/Run*.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <browser>${browser}</browser>
                        <env>${env}</env>
                        <headless>${headless}</headless>
                    </systemPropertyVariables>
                    <testFailureIgnore>true</testFailureIgnore>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven.deploy.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions.plugin.version}</version>
            </plugin>

            <!-- Same as referenced-automation-ui/-sap - installs Playwright's browser
                 binaries, needed for this repo's UI-side steps. Not bound to any
                 lifecycle phase. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <executions>
                    <execution>
                        <id>install-playwright-browsers</id>
                        <configuration>
                            <mainClass>com.microsoft.playwright.CLI</mainClass>
                            <arguments>
                                <argument>install</argument>
                                <argument>--with-deps</argument>
                                <argument>chromium</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <name>Nexus Releases Repository</name>
            <url>${env.NEXUS_RELEASE_URL}</url>
        </repository>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>Nexus Snapshots Repository</name>
            <url>${env.NEXUS_SNAPSHOT_URL}</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <profile>
            <id>report-allure</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.qameta.allure</groupId>
                        <artifactId>allure-maven</artifactId>
                        <version>2.13.0</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
