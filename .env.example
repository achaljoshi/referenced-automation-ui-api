# Copy to .env.<yourenv>.local for secrets that must never be committed.
# This repo's own tests spin up an in-process server and don't read
# BASE_URL/API_BASE_URL - they're here as the template real hybrid
# UI+API projects follow.

LOG_LEVEL=info
HEADLESS=true
BASE_URL=https://qa.example.com
API_BASE_URL=https://api.qa.example.com
