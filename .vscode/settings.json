{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.validate": ["typescript"],
  "files.exclude": {
    "node_modules": true,
    "dist": true,
    "test-results": true,
    "playwright-report": true
  },
  "cucumber.features": ["features/**/*.feature"],
  "cucumber.glue": [
    "features/**/*.ts",
    "node_modules/@automation/referenced-automation-ui/dist/bdd/dataSteps.js",
    "node_modules/@automation/referenced-automation-ui/dist/bdd/steps.js",
    "node_modules/@automation/referenced-automation-api/dist/bdd/steps.js",
    "node_modules/@automation/referenced-automation-sap/dist/gui/steps.js"
  ]
}
