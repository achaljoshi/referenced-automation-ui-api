# Committed settings for ENV=stage - no secrets (those go in .env.stage.local, see .env.example).
# LOG_LEVEL here has no effect: the logger reads only the real environment (shell / CI), not .env files.
ENV=stage
LOG_LEVEL=debug
HEADLESS=true
BASE_URL=https://stage.example.com
API_BASE_URL=https://api.stage.example.com
